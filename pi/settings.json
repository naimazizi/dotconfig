{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-terra",
  "subagents": {
    "defaultModel": "local-router/subagent-luna",
    "defaultSubagentOnlyExtensions": ["~/.config/pi/extensions/litellm.ts"]
  },
  "defaultThinkingLevel": "medium",
  "theme": "system",
  "autocompleteMaxVisible": 10,
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "packages": [
    "git:github.com/DietrichGebert/ponytail",
    "npm:@plannotator/pi-extension",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-vim",
    "git:github.com/edxeth/pi-auto-session-titles",
    "npm:pi-compass",
    "npm:pi-hermes-memory",
    "npm:pi-open-tui",
    "npm:pi-x-ide",
    "npm:pi-nvim"
  ],
  "piVim": {
    "clipboardMirror": "yank"
  },
  "collapseChangelog": true,
  "quietStartup": true,
  "defaultProjectTrust": "always",
  "treeFilterMode": "default",
  "piBolt": {
    "packages": ["npm:opensec-pi-fff", "npm:opensec-pi-todo"],
    "packagesOverlay": true
  }
}
