{
  "mcpServers": {
    "bigquery": {
      "command": "sh",
      "args": [
        "-c",
        "exec uvx --with 'mcp<1.10' mcp-server-bigquery --project \"${BIGQUERY_PROJECT:?BIGQUERY_PROJECT is required}\" --location \"${BIGQUERY_LOCATION:?BIGQUERY_LOCATION is required}\""
      ],
      "env": {
        "BIGQUERY_PROJECT": "${BIGQUERY_PROJECT}",
        "BIGQUERY_LOCATION": "${BIGQUERY_LOCATION}"
      },
      "timeout": 60
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    },
    "jupyter": {
      "command": "uvx",
      "args": ["jupyter-mcp-server@latest"],
      "enabled": false,
      "timeout": 60,
      "env": {
        "JUPYTER_URL": "${JUPYTER_URL}",
        "JUPYTER_TOKEN": "${JUPYTER_TOKEN}",
        "ALLOW_IMG_OUTPUT": "true"
      }
    },
    "lark-cli": {
      "command": "node",
      "args": ["~/.local/lib/lark-cli-mcp/index.js"]
    },
    "iwe": {
      "command": "npx",
      "args": ["-y", "@iwe-org/mcp"],
      "cwd": "~/notes"
    }
  }
}
