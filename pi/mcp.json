{
  "mcpServers": {
    "gh_grep": {
      "url": "https://mcp.grep.app"
    },
    "jupyter": {
      "command": "uvx",
      "args": ["jupyter-mcp-server@latest"],
      "enabled": false,
      "timeout": 60,
      "env": {
        "JUPYTER_URL": "${JUPYTER_URL}",
        "JUPYTER_TOKEN": "${JUPYTER_TOKEN}",
        "ALLOW_IMG_OUTPUT": "true"
      }
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ]
    },
    "lark-cli": {
      "url": "https://mcp.larksuite.com/mcp"
    },
    "iwe": {
      "command": "iwec",
      "cwd": "~/notes"
    }
  }
}
