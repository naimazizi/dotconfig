{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "kanagawa"
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "medium"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "plugins": ["./herdr-opencode"],
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status"
  }
}
