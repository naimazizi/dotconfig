          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "claude-sonnet-4-6@default": {
          "name": "claude-sonnet-4-6@default",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "claude-sonnet-4.6": {
          "name": "claude-sonnet-4.6",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-sonnet-5": {
