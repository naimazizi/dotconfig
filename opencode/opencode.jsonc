{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-6-sol",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000,
    },
    "buffer": 64000,
  },
  "plugins": [
    // "@dietrichgebert/ponytail",
    "@plannotator/opencode@latest",
  ],
  "agents": {
    "general": {
      "model": "openai/gpt-6-luna",
    },
  },
  "providers": {
    "litellm_tvlk": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LiteLLM TVLK",
      "settings": {
        "baseURL": "{env:LITELLM_API_ENDPOINT}",
      },
      "models": {
        "claude-opus-4.7": {
          "name": "claude-opus-4.7",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-sonnet-4.6": {
          "name": "claude-sonnet-4.6",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-haiku-4.5": {
          "name": "claude-haiku-4.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "bigquery": {
        "type": "local",
        "command": [
          "uvx",
          "--with",
          "mcp<1.10",
          "mcp-server-bigquery",
          "--project",
          "{env:BIGQUERY_PROJECT}",
          "--location",
          "{env:BIGQUERY_LOCATION}",
        ],
        "timeout": {
          "catalog": 3000,
          "execution": 3000,
        },
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "jupyter": {
        "type": "local",
        "disabled": true,
        "timeout": {
          "catalog": 6000,
          "execution": 6000,
        },
        "command": ["uvx", "jupyter-mcp-server@latest"],
        "environment": {
          "JUPYTER_URL": "{env:JUPYTER_URL}",
          "JUPYTER_TOKEN": "{env:JUPYTER_TOKEN}",
          "ALLOW_IMG_OUTPUT": "true",
        },
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False",
        ],
      },
      "lark-cli": {
        "type": "local",
        "command": ["node", "{env:HOME}/.local/lib/lark-cli-mcp/index.js"],
      },
      "iwe": {
        "type": "local",
        "command": ["npx", "-y", "@iwe-org/mcp"],
        "cwd": "{env:HOME}/notes",
      },
    },
  },
}
