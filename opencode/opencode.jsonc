{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "anthropic/claude-sonnet-5",
  "plugin": [
    "@dietrichgebert/ponytail",
    "@plannotator/opencode@latest",
    "opencode-claude-auth@latest",
  ],
  "provider": {
    "litellm_tvlk": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM TVLK",
      "options": {
        "baseURL": "{env:LITELLM_API_ENDPOINT}",
      },
      "models": {
        "claude-opus-4.7": {
          "name": "claude-opus-4.7",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
        },
        "claude-sonnet-4.6": {
          "name": "claude-sonnet-4.6",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
        },
        "claude-haiku-4.5": {
          "name": "claude-haiku-4.5",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5",
          "attachment": true,
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
        },
      },
    },
  },
  "permission": {
    "bash": "deny",
    "glob": "deny",
    "grep": "deny",
    "read": "deny",
  },
  "mcp": {
    "bigquery": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<1.10",
        "mcp-server-bigquery",
        "--project",
        "{env:BIGQUERY_PROJECT}",
        "--location",
        "{env:BIGQUERY_LOCATION}",
      ],
      "enabled": true,
      "timeout": 30000,
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
    },
    "jupyter": {
      "type": "local",
      "command": ["uvx", "jupyter-mcp-server@latest"],
      "env": {
        "JUPYTER_URL": "{env:JUPYTER_URL}",
        "JUPYTER_TOKEN": "{env:JUPYTER_TOKEN}",
        "ALLOW_IMG_OUTPUT": "true",
      },
      "enabled": false,
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False",
      ],
      "enabled": true,
    },
    "lean-ctx": {
      "command": ["lean-ctx"],
      "enabled": true,
      "type": "local",
    },
    "lark-cli": {
      "type": "local",
      "command": ["node", "{env:HOME}/.local/lib/lark-cli-mcp/index.js"],
      "enabled": true,
    },
  },
}
