{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-6.1-terra",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000,
    },
    "buffer": 16000,
  },
  "experimental": {
    "background_compaction": true,
  },
  "plugins": ["@dietrichgebert/ponytail", "@plannotator/opencode@latest"],
  "agents": {
    "general": {
      "model": "openai/gpt-6-luna",
    },
    "explore": {
      "model": "openai/gpt-6-luna",
    },
    "scout": {
      "description": "Read-only local code investigation with a compact handoff",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "system": "Investigate only the assigned question and relevant paths. Follow inherited safety and repository instructions. Read only enough code to identify behavior, callers, and risks. Do not edit files, run shell commands, load skills, or delegate. Report missing context or decisions to the parent. Return file and line references, findings, uncertainties, and the next recommended action in under 200 words unless more evidence is required.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "read",
          "resource": "*.env",
          "effect": "ask",
        },
        {
          "action": "read",
          "resource": "*.env.*",
          "effect": "ask",
        },
        {
          "action": "read",
          "resource": "*.env.example",
          "effect": "allow",
        },
      ],
    },
    "worker": {
      "description": "Bounded implementation and tests with a compact handoff",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "system": "Complete the assigned change within the provided file boundaries. Follow inherited safety and repository instructions. Preserve unrelated changes and use the smallest complete implementation. Run the narrowest relevant checks and report failures without hiding them. Do not install dependencies, change shared settings, or perform destructive operations without approval. Do not load skills or delegate. Report missing context or unapproved decisions to the parent. Return changed files, checks and results, blockers, and remaining risks in under 200 words unless more evidence is required.",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny",
        },
      ],
    },
  },
  "providers": {
    "litellm_tvlk": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LiteLLM TVLK",
      "env": ["LITELLM_API_KEY"],
      "settings": {
        "baseURL": "{env:LITELLM_API_ENDPOINT}",
      },
      "models": {
        "claude-haiku-4.5": {
          "name": "claude-haiku-4.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-haiku-5.5": {
          "name": "claude-haiku-5.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "claude-opus-4.7": {
          "name": "claude-opus-4.7",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-opus-4.8": {
          "name": "claude-opus-4.8",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "claude-opus-5": {
          "name": "claude-opus-5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "claude-opus-5.5": {
