{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "openai/gpt-6.1-sol",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000,
    },
    "buffer": 16000,
  },
  "plugins": [
    "@dietrichgebert/ponytail",
    "@plannotator/opencode@latest",
  ],
  "agents": {
    "general": {
      "model": "openai/gpt-6-luna",
    },
  },
  "providers": {
    "litellm_tvlk": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LiteLLM TVLK",
      "settings": {
        "baseURL": "{env:LITELLM_API_ENDPOINT}",
      },
      "models": {
        "claude-opus-4.7": {
          "name": "claude-opus-4.7",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-sonnet-4.6": {
          "name": "claude-sonnet-4.6",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-haiku-4.5": {
          "name": "claude-haiku-4.5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5",
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "jupyter": {
        "type": "local",
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000,
        },
        "command": ["uvx", "jupyter-mcp-server@latest"],
        "environment": {
          "JUPYTER_URL": "{env:JUPYTER_URL}",
          "JUPYTER_TOKEN": "{env:JUPYTER_TOKEN}",
          "ALLOW_IMG_OUTPUT": "true",
        },
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False",
        ],
      },
      "lark-cli": {
        "type": "remote",
        "url": "https://mcp.larksuite.com/mcp",
      },
      "iwe": {
        "type": "local",
        "command": ["iwec"],
        "cwd": "{env:HOME}/notes",
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp",
        "enabled": true,
      },
    },
  },
}
