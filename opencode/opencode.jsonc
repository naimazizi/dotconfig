          },
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "jupyter": {
        "type": "local",
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000,
        },
        "command": ["uvx", "jupyter-mcp-server@latest"],
        "environment": {
          "JUPYTER_URL": "{env:JUPYTER_URL}",
          "JUPYTER_TOKEN": "{env:JUPYTER_TOKEN}",
          "ALLOW_IMG_OUTPUT": "true",
        },
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "ide",
          "--open-web-dashboard",
          "False",
        ],
      },
      "lark-cli": {
        "type": "remote",
        "url": "https://mcp.larksuite.com/mcp",
      },
      "iwe": {
        "type": "local",
        "command": ["iwec"],
        "cwd": "{env:HOME}/notes",
      },
    },
  },
}
