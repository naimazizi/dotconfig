[
  {
    "key": "ctrl+;",
    "command": "pendant.focusInput",
    "when": "editorTextFocus && !editorHasSelection"
  },
  {
    "key": "ctrl+;",
    "command": "pendant.addSelectionToChat",
    "when": "editorTextFocus && editorHasSelection"
  },
  {
    "key": "ctrl+;",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus"
  }
]
