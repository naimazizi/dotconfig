{
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": false
  },
  "application.shellEnvironmentResolutionTimeout": 30,
  "chat.agentHost.allowSignedOutWhenUsable": true,
  "chat.editor.fontSize": 11,
  "chat.editor.wordWrap": "on",
  "chat.experimental.incrementalRendering.enabled": true,
  "chat.mcp.access": "all",
  "chat.mcp.gallery.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "css.lint.vendorPrefix": "ignore",
  "debug.console.fontFamily": "'Hack Nerd Font Mono', 'Monaspace Krypton NF', Consolas, 'Courier New', monospace",
  "diffEditor.experimental.showMoves": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "diffEditor.renderSideBySide": false,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeLensFontFamily": "'Hack Nerd Font Mono', 'Monaspace Krypton NF', Consolas, 'Courier New', monospace",
  "editor.detectIndentation": true,
  "editor.experimental.preferTreeSitter.regex": true,
  "editor.experimental.preferTreeSitter.typescript": true,
  "editor.fontFamily": "Monaspace Krypton NF, Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "editor.inlineSuggest.enabled": true,
  "editor.lineHeight": 1.4,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": true,
  "editor.padding.top": 10,
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "enabled": true
  },
  "editor.smoothScrolling": true,
  "editor.suggest.showWords": true,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.tabSize": 4,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?",
  "editor.wordWrap": "on",
  "emmet.showAbbreviationSuggestions": false,
  "explorer.compactFolders": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 1,
  "extensions.autoUpdate": "on",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "files.associations": {
    "*.sql": "sql"
  },
  "files.enableTrash": false,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.angular": true,
    "**/.editorconfig": true,
    "**/.eslintrc.cjs": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.husky": true,
    "**/.lintstagedrc.mjs": true,
    "**/.markdownlint.json": true,
    "**/.markdownlintignore": true,
    "**/.next": true,
    "**/.prettierignore": true,
    "**/.svn": true,
    "**/.todo.md": true,
    "**/CVS": true,
    "**/README.md": false,
    "**/Thumbs.db": true,
    "**/bun.lockb": true,
    "**/cspell.json": true,
    "**/dist": false,
    "**/drizzle": true,
    "**/drizzle.config.ts": true,
    "**/migrate.ts": true,
    "**/next-env.d.ts": true,
    "**/next.config.js": true,
    "**/node_modules": false,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/postcss.config.cjs": true,
    "**/prettier.config.js": true,
    "**/tailwind.config.ts": true
  },
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.editorDecoration.template": "(${authorDateAgo}) ${authorName}, ${subject}",
  "git.confirmSync": false,
  "git.enableCommitSigning": true,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "html.format.wrapLineLength": 300,
  "indentRainbow.colors": [
    "rgba(53, 52, 53,0.15)",
    "rgba(42, 51, 136,0.15)",
    "rgba(94, 45, 144, 0.15)",
    "rgba(123, 28, 125,0.15)",
    "rgba(218, 18, 75,0.15)",
    "rgba(239, 83, 61,0.15)",
    "rgba(246, 140, 31,0.15)",
    "rgba(246, 140, 31,0.1)",
    "rgba(246, 140, 31,0.05)",
    "rgba(246, 140, 31,0.025)"
  ],
  "jupyter.allowUnauthorizedRemoteConnection": true,
  "jupyter.askForKernelRestart": false,
  "jupyter.disableJupyterAutoStart": true,
  "jupyter.enableExtendedPythonKernelCompletions": true,
  "lazygit-vscode.configPath": "${userHome}/.config/lazygit/config.yml",
  "lldb.suppressUpdateNotifications": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.organizeImports": "explicit"
  },
  "notebook.consolidatedRunButton": true,
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "notebook.diff.experimental.toggleInline": true,
  "notebook.diff.ignoreMetadata": true,
  "notebook.formatOnSave.enabled": true,
  "notebook.lineNumbers": "on",
  "notebook.output.textLineLimit": 100,
  "notebook.output.wordWrap": true,
  "python.languageServer": "Default",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "quarto.path": "/Users/naim.azizi/quarto/bin/quarto",
  "ruff.enable": true,
  "ruff.format.preview": true,
  "ruff.importStrategy": "useBundled",
  "ruff.nativeServer": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.checkOnSave": false,
  "rust-analyzer.diagnostics.enable": false,
  "rust-analyzer.inlayHints.genericParameterHints.type.enable": true,
  "rust-analyzer.semanticHighlighting.operator.specialization.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.enable": true,
  "rust-analyzer.semanticHighlighting.punctuation.separate.macro.bang": true,
  "rust-analyzer.semanticHighlighting.punctuation.specialization.enable": true,
  "scm.inputFontFamily": "'Hack Nerd Font Mono', Monaspace Krypton NF, Consolas, 'Courier New', monospace",
  "search.exclude": {
    "**/build": true,
    "**/coverage": true,
    "**/dist": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "**/public/*": true,
    "**/target": true,
    "**/vendor/*": true,
    "**/yarn.lock": true
  },
  "search.smartCase": true,
  "security.workspace.trust.untrustedFiles": "open",
  "shandy-sqlfmt.path": "${userHome}/.local/bin/sqlfmt",
  "syncSettings.resources": ["settings", "keybindings", "snippets", "extensions"],
  "telemetry.telemetryLevel": "off",
  "terminal.external.osxExec": "ghostty",
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.fontFamily": "Monaspace Krypton NF, Consolas, 'Courier New', monospace",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.profiles.osx": {
    "bash": {
      "args": ["-l"],
      "icon": "terminal-bash",
      "path": "bash"
    },
    "fish": {
      "args": ["-l"],
      "icon": "terminal-tmux",
      "path": "/opt/homebrew/bin/fish"
    },
    "zsh": {
      "args": ["-l"],
      "path": "zsh"
    }
  },
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.suggest.enabled": true,
  "update.mode": "default",
  "update.showReleaseNotes": false,
  "vscode-neovim.compositeKeys": {
    "jj": {
      "command": "vscode-neovim.escape"
    },
    "jk": {
      "command": "vscode-neovim.escape"
    }
  },
  "vscode-neovim.compositeTimeout": 100,
  "vscode-neovim.neovimClean": false,
  "window.commandCenter": false,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Kanso Bordered Ink",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.tabActionLocation": "left",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "workbench.iconTheme": "vscode-modern-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "none",
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": false,
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "remote.extensionKind": {
    "asvetliakov.vscode-neovim": ["workspace"]
  }
}
